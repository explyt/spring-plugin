<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">

    <vendor>explyt</vendor>
    <name>Spring AI Tool Tests</name>
    <description>Overriding services and components for tests.</description>

    <xi:include href="spring-web-plugin.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="spring-core-plugin.xml" xpointer="xpointer(/idea-plugin/*)"/>
    <xi:include href="jpa-plugin.xml" xpointer="xpointer(/idea-plugin/*)"/>

    <!-- In production this file is loaded by an optional dependency on com.intellij.mcpServer. Including it here
         is what lets a test resolve a tool the way a client does, through the extension point: a toolset missing
         from it is invisible to every client, and a test that instantiated the class directly would not notice. -->
    <xi:include href="mcp-server-plugin.xml" xpointer="xpointer(/idea-plugin/*)"/>

    <extensions defaultExtensionNs="com.intellij">

    </extensions>
</idea-plugin>
